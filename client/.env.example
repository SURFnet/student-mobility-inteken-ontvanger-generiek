# The origin generiek's backend is reachable at, when this client is deployed on a different origin
# than the API (e.g. a separate static host in production). Leave empty/unset for local dev (the vite
# dev server proxies /api/... to http://localhost:8092, see vite.config.mjs) or when client and API
# share an origin in production.
VITE_API_BASE_URL=
